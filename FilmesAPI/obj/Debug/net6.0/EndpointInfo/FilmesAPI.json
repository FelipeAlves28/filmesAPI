{
  "openapi": "3.0.1",
  "info": {
    "title": "FilmesAPI",
    "version": "v1"
  },
  "paths": {
    "/Filme": {
      "post": {
        "tags": [
          "Filme"
        ],
        "summary": "Adiciona um filme",
        "requestBody": {
          "description": "Objeto para criação do filme no banco de dados",
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFilmeDto"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFilmeDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFilmeDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFilmeDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Status para quando houver criação dos dados com sucesso"
          }
        }
      },
      "get": {
        "tags": [
          "Filme"
        ],
        "summary": "Retorna uma lista de filmes",
        "parameters": [
          {
            "name": "skip",
            "in": "query",
            "description": "Utilizado para retornar por seções de acordo com o número definido",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "take",
            "in": "query",
            "description": "Utilizado para retornar a quantidade definida de resultados",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Status para quando for recuperado os filmes com sucesso",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReadFilmeDto"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReadFilmeDto"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReadFilmeDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/Filme/{id}": {
      "get": {
        "tags": [
          "Filme"
        ],
        "summary": "Retorna um filme por id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identificador para recuperar o filme no banco de dados",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Status para quando for recuperado o filme com sucesso"
          }
        }
      },
      "put": {
        "tags": [
          "Filme"
        ],
        "summary": "Atualiza todos os dados de um filme",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identificador para atualizar o filme no banco de dados",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "description": "Objeto alterado que vai ser utilizado para atualizar no banco de dados",
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFilmeDto"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFilmeDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFilmeDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFilmeDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Status para quando for atualizado o filme com sucesso"
          }
        }
      },
      "patch": {
        "tags": [
          "Filme"
        ],
        "summary": "Atualiza apenas os campos necessários de um filme",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identificador para atualizar o filme no banco de dados",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "description": "Objeto trazendo apenas o campo necessário para atualização",
          "content": {
            "application/json-patch+json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Operation"
                }
              }
            },
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Operation"
                }
              }
            },
            "text/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Operation"
                }
              }
            },
            "application/*+json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Operation"
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Status para quando for atualizado o filme com sucesso"
          }
        }
      },
      "delete": {
        "tags": [
          "Filme"
        ],
        "summary": "Deleta um filme",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identificador para deletar o filme no banco de dados",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Status para quando for atualizado o filme com sucesso"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateFilmeDto": {
        "required": [
          "duracao",
          "genero",
          "titulo"
        ],
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string"
          },
          "genero": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "duracao": {
            "maximum": 600,
            "minimum": 70,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "Operation": {
        "type": "object",
        "properties": {
          "operationType": {
            "$ref": "#/components/schemas/OperationType"
          },
          "path": {
            "type": "string",
            "nullable": true
          },
          "op": {
            "type": "string",
            "nullable": true
          },
          "from": {
            "type": "string",
            "nullable": true
          },
          "value": {
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "OperationType": {
        "enum": [
          0,
          1,
          2,
          3,
          4,
          5,
          6
        ],
        "type": "integer",
        "format": "int32"
      },
      "ReadFilmeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "titulo": {
            "type": "string",
            "nullable": true
          },
          "genero": {
            "type": "string",
            "nullable": true
          },
          "duracao": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "UpdateFilmeDto": {
        "required": [
          "duracao",
          "genero",
          "titulo"
        ],
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string"
          },
          "genero": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "duracao": {
            "maximum": 600,
            "minimum": 70,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      }
    }
  }
}